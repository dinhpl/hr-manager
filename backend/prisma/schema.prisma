generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DurationMode {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LEAVE_REQUEST_CREATED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  LEAVE_REQUEST_CANCELLED
  OVERTIME_CREATED
  OVERTIME_APPROVED
  OVERTIME_REJECTED
}

enum NotificationEntityType {
  LEAVE_REQUEST
  OVERTIME
}

enum DeviceStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum DeviceType {
  LAPTOP
  DESKTOP_PC
  MONITOR
  PHONE
  OTHER
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum MaintenanceStatus {
  OPEN
  RESOLVED
}

enum DeviceAuditAction {
  CREATED
  UPDATED
  ASSIGNED
  UNASSIGNED
  TRANSFERRED
  MAINTENANCE_OPENED
  MAINTENANCE_RESOLVED
  STATUS_CHANGED
  RETIRED
}

model User {
  id              BigInt    @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  username        String    @unique @db.VarChar(100)
  employeeCode    String?   @unique @map("employee_code") @db.VarChar(50)
  password        String
  fullName        String    @map("full_name") @db.VarChar(255)
  firstName       String?   @map("first_name") @db.VarChar(100)
  lastName        String?   @map("last_name") @db.VarChar(100)
  role            UserRole  @default(EMPLOYEE)
  systemRole      String?   @map("system_role") @db.VarChar(100)
  department      String?   @db.VarChar(100)
  position        String?   @db.VarChar(150)
  avatar          String?
  teamId          Int?      @map("team_id")
  isCountable     Boolean   @default(true) @map("is_countable")
  companyJoinDate DateTime? @map("company_join_date")
  birthday        DateTime? @map("birthday")
  hideBirthday    Boolean   @default(false) @map("hide_birthday")
  gender          String?   @db.VarChar(10)
  phone           String?   @db.VarChar(20)
  managerId       BigInt?   @map("manager_id")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  manager          User?            @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[]           @relation("UserManager")
  leaveRequests     LeaveRequest[]   @relation("UserLeaveRequests")
  approvedRequests  LeaveRequest[]   @relation("ApproverLeaveRequests")
  handoverRequests  LeaveRequest[]   @relation("HandoverPersonRequests")
  overtimeRecords  OvertimeRecord[] @relation("UserOvertimeRecords")
  approvedOT       OvertimeRecord[] @relation("ApproverOvertimeRecords")
  compOffRecords   CompOffRecord[]  @relation("UserCompOffRecords")
  approvedCompOff  CompOffRecord[]  @relation("ApproverCompOffRecords")
  leaveBalances    LeaveBalance[]
  attendances      Attendance[]
  notifications    Notification[]

  yoe        Int?    @map("yoe")
  otaRanking String? @map("ota_ranking") @db.VarChar(100)

  deviceAssignments    DeviceAssignment[]   @relation("UserDeviceAssignments")
  assignedDevices      DeviceAssignment[]   @relation("AssignedByUser")
  returnedDevices      DeviceAssignment[]   @relation("ReturnedByUser")
  reportedMaintenance  DeviceMaintenanceLog[] @relation("ReportedByUser")
  maintainedDevices    DeviceMaintenanceLog[] @relation("MaintenanceAssignedTo")
  deviceAuditLogs      DeviceAuditLog[]     @relation("DeviceAuditActor")
  userSkills           UserSkill[]

  @@map("users")
}

model LeaveType {
  id                   BigInt   @id @default(autoincrement())
  code                 String   @unique @db.VarChar(20)
  name                 String   @db.VarChar(255)
  description          String?
  defaultDays          Decimal  @default(0) @map("default_days") @db.Decimal(10, 2)
  isPaid               Boolean  @default(true) @map("is_paid")
  color                String   @default("#1DB87A") @db.VarChar(20)
  isActive             Boolean  @default(true) @map("is_active")
  maxConsecutiveDays  Int?     @map("max_consecutive_days")
  usesAnnualBalance   Boolean  @default(false) @map("uses_annual_balance")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id               BigInt             @id @default(autoincrement())
  userId           BigInt             @map("user_id")
  leaveTypeId      BigInt             @map("leave_type_id")
  fromDate         DateTime           @map("from_date")
  toDate           DateTime           @map("to_date")
  durationMode     DurationMode       @default(FULL_DAY) @map("duration_mode")
  totalDays        Decimal            @map("total_days") @db.Decimal(10, 2)
  reason           String
  handoverPersonId BigInt?            @map("handover_person_id")
  status           LeaveRequestStatus @default(PENDING)
  attachmentUrl    String?            @map("attachment_url")
  approverId       BigInt?            @map("approver_id")
  approvedAt       DateTime?          @map("approved_at")
  approvedNote     String?            @map("approved_note")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user           User      @relation("UserLeaveRequests", fields: [userId], references: [id])
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver       User?     @relation("ApproverLeaveRequests", fields: [approverId], references: [id])
  handoverPerson User?     @relation("HandoverPersonRequests", fields: [handoverPersonId], references: [id])

  @@map("leave_requests")
}

model OvertimeRecord {
  id         BigInt         @id @default(autoincrement())
  userId     BigInt         @map("user_id")
  date       DateTime
  hours      Decimal        @db.Decimal(10, 2)
  reason     String
  status     OvertimeStatus @default(PENDING)
  approverId BigInt?        @map("approver_id")
  approvedAt DateTime?      @map("approved_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user     User            @relation("UserOvertimeRecords", fields: [userId], references: [id])
  approver User?           @relation("ApproverOvertimeRecords", fields: [approverId], references: [id])
  compOffs CompOffRecord[]

  @@map("overtime_records")
}

model CompOffRecord {
  id         BigInt             @id @default(autoincrement())
  userId     BigInt             @map("user_id")
  overtimeId BigInt?            @map("overtime_id")
  fromDate   DateTime           @map("from_date")
  toDate     DateTime           @map("to_date")
  totalDays  Decimal            @map("total_days") @db.Decimal(10, 2)
  reason     String
  status     LeaveRequestStatus @default(PENDING)
  approverId BigInt?            @map("approver_id")
  approvedAt DateTime?          @map("approved_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  user     User            @relation("UserCompOffRecords", fields: [userId], references: [id])
  overtime OvertimeRecord? @relation(fields: [overtimeId], references: [id])
  approver User?           @relation("ApproverCompOffRecords", fields: [approverId], references: [id])

  @@map("comp_off_records")
}

model LeaveBalance {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  leaveTypeId      BigInt   @map("leave_type_id")
  year             Int
  annualDays       Decimal  @default(0) @map("annual_days") @db.Decimal(10, 2)
  carryOverDays    Decimal  @default(0) @map("carry_over_days") @db.Decimal(10, 2)
  seniorityDays    Decimal  @default(0) @map("seniority_days") @db.Decimal(10, 2)
  compOffDays      Decimal  @default(0) @map("comp_off_days") @db.Decimal(10, 2)
  wfhDays          Decimal  @default(0) @map("wfh_days") @db.Decimal(10, 2)
  usedDays             Decimal  @default(0) @map("used_days") @db.Decimal(10, 2)
  usedCarryOverDays    Decimal  @default(0) @map("used_carry_over_days") @db.Decimal(10, 2)
  usedCompOffDays      Decimal  @default(0) @map("used_comp_off_days") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, year])
  @@map("leave_balances")
}

model Setting {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Department management — no UI screen needed yet
model Department {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Holiday {
  id        BigInt   @id @default(autoincrement())
  date      DateTime @db.Date
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date, name])
  @@index([date])
  @@map("holidays")
}

model Notification {
  id         BigInt                 @id @default(autoincrement())
  userId     BigInt                 @map("user_id")
  type       NotificationType
  title      String                 @db.VarChar(255)
  message    String
  entityType NotificationEntityType @map("entity_type")
  entityId   BigInt?                @map("entity_id")
  isRead     Boolean                @default(false) @map("is_read")
  readAt     DateTime?              @map("read_at")
  createdAt  DateTime               @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Attendance {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  date       DateTime @db.Date
  checkIn    DateTime? @map("check_in")
  checkOut   DateTime? @map("check_out")
  workHours  Decimal  @default(0) @map("work_hours") @db.Decimal(5, 2)
  status     String   @db.VarChar(20)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([date, status])
  @@index([userId, date])
  @@map("attendances")
}

model Device {
  id            BigInt       @id @default(autoincrement())
  code          String       @unique @db.VarChar(50)
  name          String       @db.VarChar(255)
  type          DeviceType
  brand         String?      @db.VarChar(100)
  model         String?      @db.VarChar(150)
  serialNumber  String?      @unique @map("serial_number") @db.VarChar(100)
  status        DeviceStatus @default(AVAILABLE)
  purchaseDate  DateTime?    @map("purchase_date") @db.Date
  purchasePrice Decimal?     @map("purchase_price") @db.Decimal(15, 2)
  warrantyUntil DateTime?    @map("warranty_until") @db.Date
  location      String?      @db.VarChar(255)
  note          String?
  imageUrl      String?      @map("image_url")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  specs           DeviceSpec[]
  images          DeviceImage[]
  assignments     DeviceAssignment[]
  maintenanceLogs DeviceMaintenanceLog[]
  auditLogs       DeviceAuditLog[]

  @@index([status])
  @@index([type, status])
  @@map("devices")
}

model DeviceImage {
  id        BigInt   @id @default(autoincrement())
  deviceId  BigInt   @map("device_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_images")
}

model DeviceSpec {
  id        BigInt @id @default(autoincrement())
  deviceId  BigInt @map("device_id")
  specKey   String @db.VarChar(100)
  specValue String @db.VarChar(500)
  sortOrder Int    @default(0) @map("sort_order")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, specKey])
  @@map("device_specs")
}

model DeviceAssignment {
  id           BigInt           @id @default(autoincrement())
  deviceId     BigInt           @map("device_id")
  userId       BigInt           @map("user_id")
  assignedById BigInt           @map("assigned_by_id")
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  returnedAt   DateTime?        @map("returned_at")
  returnedById BigInt?          @map("returned_by_id")
  status       AssignmentStatus @default(ACTIVE)
  note         String?

  device     Device @relation(fields: [deviceId], references: [id])
  user       User   @relation("UserDeviceAssignments", fields: [userId], references: [id])
  assignedBy User   @relation("AssignedByUser", fields: [assignedById], references: [id])
  returnedBy User?  @relation("ReturnedByUser", fields: [returnedById], references: [id])

  @@index([deviceId, status])
  @@index([userId, status])
  @@map("device_assignments")
}

model DeviceMaintenanceLog {
  id           BigInt            @id @default(autoincrement())
  deviceId     BigInt            @map("device_id")
  reportedById BigInt            @map("reported_by_id")
  assignedToId BigInt?           @map("assigned_to_id")
  issue        String
  resolution   String?
  cost         Decimal?          @db.Decimal(15, 2)
  note         String?
  status       MaintenanceStatus @default(OPEN)
  startDate    DateTime          @default(now()) @map("start_date")
  resolvedAt   DateTime?         @map("resolved_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  device     Device @relation(fields: [deviceId], references: [id])
  reportedBy User   @relation("ReportedByUser", fields: [reportedById], references: [id])
  assignedTo User?  @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id])

  @@index([deviceId, status])
  @@map("device_maintenance_logs")
}

model DeviceAuditLog {
  id        BigInt            @id @default(autoincrement())
  deviceId  BigInt            @map("device_id")
  actorId   BigInt            @map("actor_id")
  action    DeviceAuditAction
  targetId  BigInt?           @map("target_id")
  meta      Json?
  note      String?
  createdAt DateTime          @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])
  actor  User   @relation("DeviceAuditActor", fields: [actorId], references: [id])

  @@index([deviceId, createdAt])
  @@index([actorId])
  @@map("device_audit_logs")
}

// ── Skill Management ──────────────────────────────────────────

model SkillCategory {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  skills    Skill[]

  @@map("skill_categories")
}

model Skill {
  id         BigInt        @id @default(autoincrement())
  name       String        @db.VarChar(200)
  categoryId BigInt        @map("category_id")
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userSkills UserSkill[]

  @@unique([name, categoryId])
  @@map("skills")
}

model SkillLevel {
  id          BigInt      @id @default(autoincrement())
  level       Int         @unique
  name        String      @db.VarChar(100)
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  userSkills  UserSkill[]

  @@map("skill_levels")
}

model UserSkill {
  id        BigInt     @id @default(autoincrement())
  userId    BigInt     @map("user_id")
  skillId   BigInt     @map("skill_id")
  levelId   BigInt     @map("level_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     SkillLevel @relation(fields: [levelId], references: [id])

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}
