generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  MANAGER
  HR
  ADMIN
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DurationMode {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompensationType {
  COMP_OFF
  PAYMENT
}

enum NotificationType {
  LEAVE_REQUEST_CREATED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  LEAVE_REQUEST_CANCELLED
  OVERTIME_CREATED
  OVERTIME_APPROVED
  OVERTIME_REJECTED
}

enum NotificationEntityType {
  LEAVE_REQUEST
  OVERTIME
}

enum DeviceStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum DeviceType {
  LAPTOP
  DESKTOP_PC
  MONITOR
  PHONE
  OTHER
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum MaintenanceStatus {
  OPEN
  RESOLVED
}

enum DeviceAuditAction {
  CREATED
  UPDATED
  ASSIGNED
  UNASSIGNED
  TRANSFERRED
  MAINTENANCE_OPENED
  MAINTENANCE_RESOLVED
  STATUS_CHANGED
  RETIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CANCEL
  LOGIN
  LOGOUT
  EXPORT
  UPLOAD
}

enum AuditModule {
  AUTH
  USER
  LEAVE_REQUEST
  LEAVE_TYPE
  LEAVE_BALANCE
  OVERTIME
  COMP_OFF
  ATTENDANCE
  HOLIDAY
  DEPARTMENT
  DEVICE
  SKILL
  USER_SKILL
  SETTING
  RECRUITMENT
}

model User {
  id              BigInt    @id @default(autoincrement())
  email           String    @unique @db.VarChar(255)
  username        String    @unique @db.VarChar(100)
  employeeCode    String?   @unique @map("employee_code") @db.VarChar(50)
  password        String
  fullName        String    @map("full_name") @db.VarChar(255)
  role            UserRole  @default(EMPLOYEE)
  systemRole      String?   @map("system_role") @db.VarChar(100)
  department      String?   @db.VarChar(100)
  position        String?   @db.VarChar(150)
  avatar          String?
  teamId          Int?      @map("team_id")
  isCountable     Boolean   @default(true) @map("is_countable")
  isAttendance    Boolean   @default(true) @map("is_attendance")
  preJoinDate     DateTime? @map("pre_join_date")
  companyJoinDate DateTime? @map("company_join_date")
  birthday        DateTime? @map("birthday")
  hideBirthday    Boolean   @default(false) @map("hide_birthday")
  gender          String?   @db.VarChar(10)
  phone           String?   @db.VarChar(20)
  managerId       BigInt?   @map("manager_id")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  manager          User?            @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[]           @relation("UserManager")
  leaveRequests     LeaveRequest[]   @relation("UserLeaveRequests")
  handoverRequests  LeaveRequest[]   @relation("HandoverPersonRequests")
  overtimeRecords  OvertimeRecord[] @relation("UserOvertimeRecords")
  approvedOT       OvertimeRecord[] @relation("ApproverOvertimeRecords")
  compOffRecords   CompOffRecord[]  @relation("UserCompOffRecords")
  approvedCompOff  CompOffRecord[]  @relation("ApproverCompOffRecords")
  leaveBalances    LeaveBalance[]
  attendances      Attendance[]
  notifications    Notification[]

  yoe        Int?    @map("yoe")
  otaRanking String? @map("ota_ranking") @db.VarChar(100)

  deviceAssignments    DeviceAssignment[]   @relation("UserDeviceAssignments")
  assignedDevices      DeviceAssignment[]   @relation("AssignedByUser")
  returnedDevices      DeviceAssignment[]   @relation("ReturnedByUser")
  reportedMaintenance  DeviceMaintenanceLog[] @relation("ReportedByUser")
  maintainedDevices    DeviceMaintenanceLog[] @relation("MaintenanceAssignedTo")
  deviceAuditLogs      DeviceAuditLog[]     @relation("DeviceAuditActor")
  userSkills           UserSkill[]
  auditLogs            AuditLog[]           @relation("AuditLogActor")
  createdPositions     JobPosition[]        @relation("PositionCreatedBy")
  stageLogs            CandidateStageLog[]  @relation("StageLogChangedBy")

  @@map("users")
}

// ─── Recruitment ─────────────────────────────────────────────

model JobPosition {
  id                BigInt    @id @default(autoincrement())
  title             String    @db.VarChar(255)
  level             String    @default("") @db.VarChar(100)
  domain            String    @default("") @db.VarChar(100)
  priority          String    @default("B") @db.VarChar(10)
  headcount         Int       @default(1)
  currentStage      String    @default("APPLIED") @map("current_stage") @db.VarChar(50)
  status            String    @default("NOT_STARTED") @db.VarChar(50)
  requestDate       DateTime? @map("request_date")
  onboardDeadline   DateTime? @map("onboard_deadline")
  descriptionSkills String?   @map("description_skills") @db.Text
  salaryRangeUsd    String?   @map("salary_range_usd") @db.VarChar(255)
  mainSkills        String?   @map("main_skills") @db.Text
  jdDetails         String?   @map("jd_details") @db.Text
  cvSource          String?   @map("cv_source") @db.Text
  note              String?   @db.Text
  blocker           String?   @db.Text
  openedAt          DateTime  @default(now()) @map("opened_at")
  closedAt          DateTime? @map("closed_at")
  createdById       BigInt    @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  createdBy   User                   @relation("PositionCreatedBy", fields: [createdById], references: [id])
  candidates  RecruitmentCandidate[]
  weeklyStats WeeklyKpi[]
  insights    RecruitmentInsight[]

  @@map("job_positions")
}

model RecruitmentInsight {
  id          BigInt   @id @default(autoincrement())
  positionId  BigInt   @map("position_id")
  type        String   @db.VarChar(20)
  content     String   @db.Text
  createdById BigInt?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  position JobPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, type])
  @@map("recruitment_insights")
}

model RecruitmentCandidate {
  id           BigInt   @id @default(autoincrement())
  positionId   BigInt   @map("position_id")
  fullName     String   @map("full_name") @db.VarChar(255)
  email        String?  @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  source       String   @default("OTHER") @db.VarChar(50)
  currentStage String   @default("APPLIED") @map("current_stage") @db.VarChar(50)
  cvUrl        String?  @map("cv_url") @db.VarChar(500)
  note         String?  @db.Text
  appliedAt    DateTime @default(now()) @map("applied_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  position     JobPosition          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  stageHistory CandidateStageLog[]

  @@index([positionId])
  @@map("recruitment_candidates")
}

model WeeklyKpi {
  id          BigInt @id @default(autoincrement())
  positionId  BigInt @map("position_id")
  year        Int
  month       Int
  week        Int
  stage       String @db.VarChar(50)
  kpiTarget   Int    @default(0) @map("kpi_target")
  actual      Int    @default(0)

  position JobPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, year, month, week, stage])
  @@index([positionId, year, month])
  @@map("weekly_kpis")
}

model CandidateStageLog {
  id          BigInt   @id @default(autoincrement())
  candidateId BigInt   @map("candidate_id")
  fromStage   String?  @map("from_stage") @db.VarChar(50)
  toStage     String   @map("to_stage") @db.VarChar(50)
  changedById BigInt   @map("changed_by_id")
  changedAt   DateTime @default(now()) @map("changed_at")
  note        String?  @db.Text

  candidate   RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  changedBy   User                 @relation("StageLogChangedBy", fields: [changedById], references: [id])

  @@index([candidateId])
  @@map("candidate_stage_logs")
}

model LeaveType {
  id                   BigInt   @id @default(autoincrement())
  code                 String   @unique @db.VarChar(20)
  name                 String   @db.VarChar(255)
  description          String?
  defaultDays          Decimal  @default(0) @map("default_days") @db.Decimal(10, 2)
  isPaid               Boolean  @default(true) @map("is_paid")
  color                String   @default("#1DB87A") @db.VarChar(20)
  isActive             Boolean  @default(true) @map("is_active")
  maxConsecutiveDays  Int?     @map("max_consecutive_days")
  usesAnnualBalance   Boolean  @default(false) @map("uses_annual_balance")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id               BigInt             @id @default(autoincrement())
  userId           BigInt             @map("user_id")
  leaveTypeId      BigInt             @map("leave_type_id")
  fromDate         DateTime           @map("from_date")
  toDate           DateTime           @map("to_date")
  durationMode     DurationMode       @default(FULL_DAY) @map("duration_mode")
  totalDays        Decimal            @map("total_days") @db.Decimal(10, 2)
  reason           String
  handoverPersonId BigInt?            @map("handover_person_id")
  status           LeaveRequestStatus @default(PENDING)
  attachmentUrl    String?            @map("attachment_url")
  approverId       String?            @map("approver_id")
  approvedAt       DateTime?          @map("approved_at")
  approvedNote     String?            @map("approved_note")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user           User      @relation("UserLeaveRequests", fields: [userId], references: [id])
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  handoverPerson User?     @relation("HandoverPersonRequests", fields: [handoverPersonId], references: [id])

  @@map("leave_requests")
}

model OvertimeRecord {
  id         BigInt         @id @default(autoincrement())
  userId     BigInt         @map("user_id")
  date               DateTime
  startTime          String?           @map("start_time") @db.VarChar(5)
  endTime            String?           @map("end_time") @db.VarChar(5)
  hours              Decimal           @db.Decimal(10, 2)
  reason             String
  status             OvertimeStatus    @default(PENDING)
  compensationType   CompensationType  @default(COMP_OFF) @map("compensation_type")
  approverId BigInt?        @map("approver_id")
  approvedAt DateTime?      @map("approved_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user     User            @relation("UserOvertimeRecords", fields: [userId], references: [id])
  approver User?           @relation("ApproverOvertimeRecords", fields: [approverId], references: [id])
  compOffs CompOffRecord[]

  @@map("overtime_records")
}

model CompOffRecord {
  id         BigInt             @id @default(autoincrement())
  userId     BigInt             @map("user_id")
  overtimeId BigInt?            @map("overtime_id")
  fromDate   DateTime           @map("from_date")
  toDate     DateTime           @map("to_date")
  totalDays  Decimal            @map("total_days") @db.Decimal(10, 2)
  reason     String
  status     LeaveRequestStatus @default(PENDING)
  approverId BigInt?            @map("approver_id")
  approvedAt DateTime?          @map("approved_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  user     User            @relation("UserCompOffRecords", fields: [userId], references: [id])
  overtime OvertimeRecord? @relation(fields: [overtimeId], references: [id])
  approver User?           @relation("ApproverCompOffRecords", fields: [approverId], references: [id])

  @@map("comp_off_records")
}

model LeaveBalance {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  leaveTypeId      BigInt   @map("leave_type_id")
  year             Int
  annualDays       Decimal  @default(0) @map("annual_days") @db.Decimal(10, 2)
  carryOverDays    Decimal  @default(0) @map("carry_over_days") @db.Decimal(10, 2)
  seniorityDays    Decimal  @default(0) @map("seniority_days") @db.Decimal(10, 2)
  compOffDays      Decimal  @default(0) @map("comp_off_days") @db.Decimal(10, 2)
  wfhDays          Decimal  @default(0) @map("wfh_days") @db.Decimal(10, 2)
  usedDays             Decimal  @default(0) @map("used_days") @db.Decimal(10, 2)
  usedCarryOverDays    Decimal  @default(0) @map("used_carry_over_days") @db.Decimal(10, 2)
  usedCompOffDays      Decimal  @default(0) @map("used_comp_off_days") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  note             String?  @db.Text
  user      User      @relation(fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, year])
  @@map("leave_balances")
}

model Setting {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Department management — no UI screen needed yet
model Department {
  id        BigInt   @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Holiday {
  id        BigInt   @id @default(autoincrement())
  date      DateTime @db.Date
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([date, name])
  @@index([date])
  @@map("holidays")
}

model Notification {
  id         BigInt                 @id @default(autoincrement())
  userId     BigInt                 @map("user_id")
  type       NotificationType
  title      String                 @db.VarChar(255)
  message    String
  entityType NotificationEntityType @map("entity_type")
  entityId   BigInt?                @map("entity_id")
  isRead     Boolean                @default(false) @map("is_read")
  readAt     DateTime?              @map("read_at")
  createdAt  DateTime               @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Attendance {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  date       DateTime @db.Date
  checkIn    DateTime? @map("check_in")
  checkOut   DateTime? @map("check_out")
  workHours  Decimal  @default(0) @map("work_hours") @db.Decimal(5, 2)
  status     String   @db.VarChar(20)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([date, status])
  @@index([userId, date])
  @@map("attendances")
}

model Device {
  id            BigInt       @id @default(autoincrement())
  code          String       @unique @db.VarChar(50)
  name          String       @db.VarChar(255)
  type          DeviceType
  brand         String?      @db.VarChar(100)
  model         String?      @db.VarChar(150)
  serialNumber  String?      @unique @map("serial_number") @db.VarChar(100)
  status        DeviceStatus @default(AVAILABLE)
  purchaseDate  DateTime?    @map("purchase_date") @db.Date
  purchasePrice Decimal?     @map("purchase_price") @db.Decimal(15, 2)
  warrantyUntil DateTime?    @map("warranty_until") @db.Date
  location      String?      @db.VarChar(255)
  note          String?
  imageUrl      String?      @map("image_url")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  specs           DeviceSpec[]
  images          DeviceImage[]
  assignments     DeviceAssignment[]
  maintenanceLogs DeviceMaintenanceLog[]
  auditLogs       DeviceAuditLog[]

  @@index([status])
  @@index([type, status])
  @@map("devices")
}

model DeviceImage {
  id        BigInt   @id @default(autoincrement())
  deviceId  BigInt   @map("device_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_images")
}

model DeviceSpec {
  id        BigInt @id @default(autoincrement())
  deviceId  BigInt @map("device_id")
  specKey   String @db.VarChar(100)
  specValue String @db.VarChar(500)
  sortOrder Int    @default(0) @map("sort_order")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, specKey])
  @@map("device_specs")
}

model DeviceAssignment {
  id           BigInt           @id @default(autoincrement())
  deviceId     BigInt           @map("device_id")
  userId       BigInt           @map("user_id")
  assignedById BigInt           @map("assigned_by_id")
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  returnedAt   DateTime?        @map("returned_at")
  returnedById BigInt?          @map("returned_by_id")
  status       AssignmentStatus @default(ACTIVE)
  note         String?

  device     Device @relation(fields: [deviceId], references: [id])
  user       User   @relation("UserDeviceAssignments", fields: [userId], references: [id])
  assignedBy User   @relation("AssignedByUser", fields: [assignedById], references: [id])
  returnedBy User?  @relation("ReturnedByUser", fields: [returnedById], references: [id])

  @@index([deviceId, status])
  @@index([userId, status])
  @@map("device_assignments")
}

model DeviceMaintenanceLog {
  id           BigInt            @id @default(autoincrement())
  deviceId     BigInt            @map("device_id")
  reportedById BigInt            @map("reported_by_id")
  assignedToId BigInt?           @map("assigned_to_id")
  issue        String
  resolution   String?
  cost         Decimal?          @db.Decimal(15, 2)
  note         String?
  status       MaintenanceStatus @default(OPEN)
  startDate    DateTime          @default(now()) @map("start_date")
  resolvedAt   DateTime?         @map("resolved_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  device     Device @relation(fields: [deviceId], references: [id])
  reportedBy User   @relation("ReportedByUser", fields: [reportedById], references: [id])
  assignedTo User?  @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id])

  @@index([deviceId, status])
  @@map("device_maintenance_logs")
}

model DeviceAuditLog {
  id        BigInt            @id @default(autoincrement())
  deviceId  BigInt            @map("device_id")
  actorId   BigInt            @map("actor_id")
  action    DeviceAuditAction
  targetId  BigInt?           @map("target_id")
  meta      Json?
  note      String?
  createdAt DateTime          @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])
  actor  User   @relation("DeviceAuditActor", fields: [actorId], references: [id])

  @@index([deviceId, createdAt])
  @@index([actorId])
  @@map("device_audit_logs")
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  actorId    BigInt      @map("actor_id")
  actorName  String      @map("actor_name")
  actorRole  String      @map("actor_role")
  action     AuditAction
  module     AuditModule
  entityId   String?     @map("entity_id")
  entityName String?     @map("entity_name")
  changes    Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  actor User @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([module, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Skill Management ──────────────────────────────────────────

model SkillCategory {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  skills    Skill[]

  @@map("skill_categories")
}

model Skill {
  id         BigInt        @id @default(autoincrement())
  name       String        @db.VarChar(200)
  categoryId BigInt        @map("category_id")
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userSkills UserSkill[]

  @@unique([name, categoryId])
  @@map("skills")
}

model SkillLevel {
  id          BigInt      @id @default(autoincrement())
  level       Int         @unique
  name        String      @db.VarChar(100)
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  userSkills  UserSkill[]

  @@map("skill_levels")
}

model UserSkill {
  id        BigInt     @id @default(autoincrement())
  userId    BigInt     @map("user_id")
  skillId   BigInt     @map("skill_id")
  levelId   BigInt     @map("level_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     SkillLevel @relation(fields: [levelId], references: [id])

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}
